+export function inspectC4(){const svg=document.querySelector('svg'),v=svg.viewBox.baseVal;return{view:{x:v.x,y:v.y,width:v.width,height:v.height},elements:[...svg.querySelectorAll('rect,circle,polygon,path,line,text')].filter(e=>!e.closest('defs')&&(e.tagName!=='rect'||e.getBBox().width!==0||e.getBBox().height!==0)).map(e=>{const b=e.getBBox(),m=svg.getScreenCTM().inverse().multiply(e.getScreenCTM()),s=getComputedStyle(e),points=[[b.x,b.y],[b.x+b.width,b.y],[b.x,b.y+b.height],[b.x+b.width,b.y+b.height]].map(([x,y])=>({x:m.a*x+m.c*y+m.e,y:m.b*x+m.d*y+m.f})),xs=points.map(p=>p.x),ys=points.map(p=>p.y);return{type:e.tagName,text:e.tagName==='text'?e.textContent:null,path:e.getAttribute('d'),points:e.getAttribute('points'),box:{x:Math.min(...xs),y:Math.min(...ys),width:Math.max(...xs)-Math.min(...xs),height:Math.max(...ys)-Math.min(...ys)},paint:{fill:s.fill,stroke:s.stroke,width:s.strokeWidth,dash:s.strokeDasharray,opacity:s.opacity,anchor:s.textAnchor},font:e.tagName==='text'?{size:s.fontSize,family:s.fontFamily,weight:s.fontWeight}:null};})};}
+if(!process.argv.includes('--library')){const directory=resolve(process.argv[2]??'build/mermaid-cpp/c4-browser');mkdirSync(directory,{recursive:true});const url=pathToFileURL(resolve('tools/mermaid-cpp/oracle/node_modules/mermaid/dist/mermaid.esm.mjs')).href;const successes=cases.filter(c=>c[2]!==null);const browser=await chromium.launch({executablePath:process.env.FOLIA_BROWSER??'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true,args:['--allow-file-access-from-files']});const rows=[];try{for(const [name,source]of successes)for(const theme of ['default','dark']){const file=resolve(directory,'probe.html');writeFileSync(file,`<!doctype html><meta charset="utf-8"><body><script type="module">const {default:mermaid}=await import(${JSON.stringify(url)});try{mermaid.initialize({startOnLoad:false,theme:${JSON.stringify(theme)},fontFamily:'Arial'});const {svg}=await mermaid.render('mermaid-c4',${JSON.stringify(source)});document.body.innerHTML=svg;const observation=(${inspectC4.toString()})();document.body.innerHTML='<pre id="result"></pre>';document.querySelector('pre').textContent=JSON.stringify({svg,...observation});}catch(e){document.body.innerHTML='<pre id="error"></pre>';document.querySelector('pre').textContent=e.stack;}</script>`);const page=await browser.newPage({timezoneId:'UTC'});await page.goto(pathToFileURL(file).href);await page.waitForSelector('pre#result,pre#error',{timeout:60000});assert.equal(await page.locator('#error').count(),0,await page.locator('pre').textContent());rows.push({name:name+'-'+theme,source,theme,...JSON.parse(await page.locator('#result').textContent())});await page.close();}}finally{await browser.close();}assert.equal(rows.length,16);writeFileSync(resolve(directory,'original.json'),JSON.stringify(rows,null,2));for(const row of rows)writeFileSync(resolve(directory,row.name+'.svg'),row.svg);console.log(`Captured ${rows.length} original C4 SVGs in fresh per-request pages.`);}
