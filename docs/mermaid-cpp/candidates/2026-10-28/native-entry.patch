+if(!process.argv.includes('--library')){const directory=resolve(process.argv[2]??'build/mermaid-cpp/state-browser');mkdirSync(directory,{recursive:true});const url=pathToFileURL(resolve('tools/mermaid-cpp/oracle/node_modules/mermaid/dist/mermaid.esm.mjs')).href;const successes=cases.filter(c=>c[2]!==null);const browser=await chromium.launch({executablePath:process.env.FOLIA_BROWSER??'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true,args:['--allow-file-access-from-files']});const rows=[];try{for(const [name,source]of successes)for(const theme of ['default','dark']){const file=resolve(directory,'probe.html');writeFileSync(file,`<!doctype html><meta charset="utf-8"><body><script type="module">const {default:mermaid}=await import(${JSON.stringify(url)});try{mermaid.initialize({startOnLoad:false,theme:${JSON.stringify(theme)},fontFamily:'Arial',themeVariables:{fontFamily:'Arial'},look:'classic',layout:'dagre'});const {svg}=await mermaid.render('mermaid-state',${JSON.stringify(source)});document.body.innerHTML=svg;const observation=(${inspectState.toString()})();document.body.innerHTML='<pre id="result"></pre>';document.querySelector('pre').textContent=JSON.stringify({svg,...observation});}catch(e){document.body.innerHTML='<pre id="error"></pre>';document.querySelector('pre').textContent=e.stack;}</script>`);const page=await browser.newPage({timezoneId:'UTC'});await page.goto(pathToFileURL(file).href);await page.waitForSelector('pre#result,pre#error',{timeout:60000});assert.equal(await page.locator('#error').count(),0,await page.locator('pre').textContent());rows.push({name:name+'-'+theme,source,theme,...JSON.parse(await page.locator('#result').textContent())});await page.close();}}finally{await browser.close();}assert.equal(rows.length,16);writeFileSync(resolve(directory,'original.json'),JSON.stringify(rows,null,2));for(const row of rows)writeFileSync(resolve(directory,row.name+'.svg'),row.svg);console.log(`Captured ${rows.length} original State SVGs in fresh per-request pages.`);}
