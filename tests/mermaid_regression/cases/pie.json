      "source": "pie showData\ntitle Product mix and a highlighted small category\n\"Desktop editors\": 421.75\n\"Mobile readers\": 198.25\n\"Web integrations\": 75.5\n\"Offline sync\": 23.25\n\"Extensions\": 5.125\n\"Other\": 0.125\n",
      "features": [
        "donut",
        "legend-top",
        "highlight-slice",
        "fractional-values",
        "unequal-slices",
        "show-data"
      ],
      "upstream": {
