<Window
    x:Class="Folia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Folia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Folia">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden"
        RowDefinitions="48,1,Auto,Auto,*,Auto">
        <Grid.Resources>
          <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="workspace/WorkspaceChrome.xaml"/><ResourceDictionary Source="workspace/FolderExplorer.xaml"/></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="FoliaShellBackgroundBrush" Color="#121419"/>
            <SolidColorBrush x:Key="FoliaShellLayerBrush" Color="#191C23"/>
            <SolidColorBrush x:Key="FoliaShellBorderBrush" Color="#343A46"/>
            <SolidColorBrush x:Key="FoliaShellForegroundBrush" Color="#E4E8F0"/>
            <SolidColorBrush x:Key="FoliaShellMutedForegroundBrush" Color="#8B95AA"/>
            <SolidColorBrush x:Key="FoliaShellAccentBrush" Color="#7AA2F7"/>
            <FontFamily x:Key="FoliaUiFontFamily">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="FoliaMonoFontFamily">Cascadia Mono</FontFamily>
            <x:Double x:Key="FoliaUiFontSize">14</x:Double>
            <Style x:Key="CodeLanguagePickerPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>
            <DataTemplate x:Key="CodeLanguagePickerTemplate">
                <Grid Width="248" RowDefinitions="Auto,Auto">
                    <TextBox x:Name="Search" MinHeight="32" FontSize="14" FontFamily="{ThemeResource FoliaUiFontFamily}"
                             BorderThickness="0" Padding="8,4" CornerRadius="4"/>
                    <ListView x:Name="Languages" Grid.Row="1" Margin="0,6,0,0" MaxHeight="224"
                              FontSize="14" FontFamily="{ThemeResource FoliaUiFontFamily}" SelectionMode="Single" IsItemClickEnabled="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </DataTemplate>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
                <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
                <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
            </Style>
          </ResourceDictionary>
        </Grid.Resources>
        <TabView x:Name="DocumentTabs" Grid.RowSpan="6" VerticalAlignment="Stretch"
                 TabWidthMode="SizeToContent" CanDragTabs="True" CanReorderTabs="True" AllowDrop="True"
                 Padding="0,6,0,6" BorderThickness="0" Background="Transparent">
            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem Tag="{Binding}" DataContextChanged="DocumentTabPrepared" Loaded="DocumentTabLoaded"/>
                </DataTemplate>
            </TabView.TabItemTemplate>
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                <Thickness x:Key="TabViewItemAddButtonContainerPadding">4,12,4,12</Thickness>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <Button x:Name="MainMenuButton" Height="32" Margin="8,8,12,8" Padding="10,0" Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="MainMenuLabel" Text="Folia" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="10"/>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutSubItem x:Name="FileMenu" Text="File">
                                <MenuFlyoutItem x:Name="NewButton" Text="New document" KeyboardAcceleratorTextOverride="Ctrl+N"/>
                                <MenuFlyoutItem x:Name="OpenButton" Text="Open file" KeyboardAcceleratorTextOverride="Ctrl+O"/>
                                <MenuFlyoutItem x:Name="OpenFolderButton" Text="Open folder" KeyboardAcceleratorTextOverride="Ctrl+Shift+O"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="SaveButton" Text="Save" KeyboardAcceleratorTextOverride="Ctrl+S"/>
                                <MenuFlyoutItem x:Name="SaveAsButton" Text="Save as"/>
                                <MenuFlyoutItem x:Name="ReloadButton" Text="Reload"/>
                                <MenuFlyoutItem x:Name="ExportPdfButton" Text="PDF"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="CloseTabButton" Text="Close tab" KeyboardAcceleratorTextOverride="Ctrl+W"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="EditMenu" Text="Edit">
                                <MenuFlyoutItem x:Name="UndoButton" Text="Undo"/>
                                <MenuFlyoutItem x:Name="RedoButton" Text="Redo"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="EditCutButton" Text="Cut"/>
                                <MenuFlyoutItem x:Name="EditCopyButton" Text="Copy"/>
                                <MenuFlyoutItem x:Name="EditPasteButton" Text="Paste"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="FindButton" Text="Find"/>
                                <MenuFlyoutItem x:Name="ReplaceButton" Text="Replace"/>
                                <MenuFlyoutSubItem x:Name="FormatMenu" Text="Format">
                                    <ToggleMenuFlyoutItem x:Name="BoldButton" Text="Bold"/>
                                    <ToggleMenuFlyoutItem x:Name="ItalicButton" Text="Italic"/>
                                    <ToggleMenuFlyoutItem x:Name="StrikeButton" Text="Strikethrough"/>
                                    <ToggleMenuFlyoutItem x:Name="InlineCodeButton" Text="Inline code"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="FormatDocumentButton" Text="Format document"/>
                                </MenuFlyoutSubItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="ViewMenu" Text="View">
                                <ToggleMenuFlyoutItem x:Name="ExplorerToggleButton" Text="Files" IsChecked="True"/>
                                <ToggleMenuFlyoutItem x:Name="SidebarToggleButton" Text="Outline" IsChecked="True"/>
                                <ToggleMenuFlyoutItem x:Name="SettingsButton" Text="Settings"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid Height="48" MinWidth="124" ColumnDefinitions="*,Auto,Auto,Auto">
                    <Border x:Name="TitleDragArea" Background="Transparent" MinWidth="48"/>
                    <ToggleButton x:Name="ExplorerPaneButton" Grid.Column="1" Width="28" Height="28" Margin="0,0,2,0" Style="{StaticResource WorkspacePaneToggleStyle}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="OutlinePaneButton" Grid.Column="2" Width="28" Height="28" Margin="0,0,8,0" Style="{StaticResource WorkspacePaneToggleStyle}" VerticalAlignment="Center"/>
                    <Border x:Name="CaptionInset" Grid.Column="3" Width="138"/>
                </Grid>
            </TabView.TabStripFooter>
        </TabView>
        <Border x:Name="ShellDivider" Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{ThemeResource FoliaShellBorderBrush}" IsHitTestVisible="False"/>
        <InfoBar
            x:Name="ExternalChangeInfoBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="The file changed on disk">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ReloadExternalButton" Content="Reload"/>
                    <Button x:Name="KeepLocalButton" Content="Keep local changes"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <Border
            x:Name="FindReplaceBar"
            Grid.Row="3"
            Padding="10,8"
            Background="{ThemeResource FoliaShellLayerBrush}"
            BorderBrush="{ThemeResource FoliaShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox
                        x:Name="FindQueryBox"
                        Width="320"
                        MinWidth="180"
                        PlaceholderText="Find"/>
                    <ToggleButton
                        x:Name="FindRegexButton"
                        MinWidth="36"
                        Content=".*"
                        FontFamily="{ThemeResource FoliaMonoFontFamily}"
                        ToolTipService.ToolTip="Regular expression"/>
                    <ToggleButton
                        x:Name="FindCaseButton"
                        MinWidth="36"
                        Content="Aa"
                        ToolTipService.ToolTip="Match case"/>
                    <TextBlock
                        x:Name="FindMatchCountText"
                        MinWidth="72"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                        Text="0 results"/>
                    <Button x:Name="FindPreviousButton" MinWidth="36" Content="↑" ToolTipService.ToolTip="Previous match"/>
                    <Button x:Name="FindNextButton" MinWidth="36" Content="↓" ToolTipService.ToolTip="Next match"/>
                </StackPanel>
                <Button
                    x:Name="CloseFindButton"
                    Grid.Column="1"
                    MinWidth="36"
                    Content="&#xE711;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Close"/>
                <StackPanel
                    x:Name="ReplaceControls"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="ReplaceTextBox"
                        Width="320"
                        MinWidth="180"
                        PlaceholderText="Replace"/>
                    <Button x:Name="ReplaceCurrentButton" Content="Replace"/>
                    <Button x:Name="ReplaceAllButton" Content="Replace all"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceHost" Grid.Row="4">
            <SplitView x:Name="DocumentWorkspace" DisplayMode="Inline" PanePlacement="Left" OpenPaneLength="248" IsPaneOpen="False" PaneBackground="{ThemeResource FoliaShellLayerBrush}">
                <SplitView.Pane>
                <Grid x:Name="ExplorerPane" Background="{ThemeResource FoliaShellLayerBrush}" RowDefinitions="Auto,*" BorderBrush="{ThemeResource FoliaShellBorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="FileOperationPanel" Grid.Row="0" Margin="16,8,12,8" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="FileOperationText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
                        <ProgressBar x:Name="FileOperationProgress" Height="2" MinHeight="2" IsIndeterminate="True"/>
                    </StackPanel>
                    <StackPanel x:Name="ExplorerEmptyState" Grid.Row="1" Margin="16,20" Spacing="8" VerticalAlignment="Top">
                        <TextBlock x:Name="NoFolderHeading" FontSize="13" FontWeight="SemiBold" Text="No folder open"/>
                        <TextBlock x:Name="NoFolderHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}" Text="Open a folder to browse Markdown files."/>
                        <HyperlinkButton x:Name="OpenFolderPaneButton" Content="Open folder…" HorizontalAlignment="Left" Padding="0" FontSize="13"/>
                    </StackPanel>
                    <TreeView x:Name="FileTree" Grid.Row="1" Margin="6,6,6,8" Style="{StaticResource ExplorerTreeStyle}" Visibility="Collapsed"/>
                </Grid>
                </SplitView.Pane>
                <SplitView.Content>
                  <SplitView x:Name="OutlineSplitView" DisplayMode="Inline" PanePlacement="Right" OpenPaneLength="252" IsPaneOpen="False" PaneBackground="{ThemeResource FoliaShellLayerBrush}">
                   <SplitView.Pane>
                <Grid
                        x:Name="OutlinePaneContent"
                        Padding="8,0,8,8"
                        Background="{ThemeResource FoliaShellLayerBrush}"
                        BorderBrush="{ThemeResource FoliaShellBorderBrush}" BorderThickness="1,0,0,0"
                        RowDefinitions="Auto,*">
                        <Grid Height="42" ColumnDefinitions="*">
                          <TextBlock
                            x:Name="OutlineHeadingText"
                            Margin="8,0,8,0" VerticalAlignment="Center"
                            FontWeight="SemiBold" FontSize="13"
                            Text="Outline"/>

                        </Grid>
                        <ListView
                            x:Name="OutlineList"
                            Grid.Row="1"
                            Background="Transparent"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollMode="Enabled"
                            SelectionMode="Single"/>
                </Grid>
                   </SplitView.Pane>
                   <SplitView.Content>
                <Grid x:Name="EditorPane">

                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="EditorScrollBarColumn" Width="16"/>
                    </Grid.ColumnDefinitions>
                    <SwapChainPanel x:Name="EditorSurface" Grid.Column="0" KeyboardAcceleratorPlacementMode="Hidden">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="CodeLanguageFlyout" Placement="BottomEdgeAlignedLeft"
                                    FlyoutPresenterStyle="{StaticResource CodeLanguagePickerPresenterStyle}"/>
                        </FlyoutBase.AttachedFlyout>
                        <SwapChainPanel.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="CutMenuItem" Text="Cut"/>
                                <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy"/>
                                <MenuFlyoutItem x:Name="PasteMenuItem" Text="Paste"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="SelectAllMenuItem" Text="Select All"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutSubItem x:Name="InsertButton" Text="Insert">
                                    <MenuFlyoutItem x:Name="TableButton" Text="Table"/>
                                    <MenuFlyoutItem x:Name="InlineMathButton" Text="Inline math"/>
                                    <MenuFlyoutItem x:Name="LinkButton" Text="Link"/>
                                    <MenuFlyoutItem x:Name="ImageButton" Text="Image"/>
                                    <MenuFlyoutItem x:Name="FootnoteButton" Text="Footnote"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="TocButton" Text="Table of contents"/>
                                    <MenuFlyoutSubItem x:Name="BlocksButton" Text="Blocks">
                                        <MenuFlyoutSubItem x:Name="HeadingMenuItem" Text="Heading">
                                            <MenuFlyoutItem x:Name="Heading1Button" Text="Heading 1"/>
                                            <MenuFlyoutItem x:Name="Heading2Button" Text="Heading 2"/>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem x:Name="QuoteButton" Text="Quote"/>
                                        <MenuFlyoutSubItem x:Name="ListMenuItem" Text="List">
                                            <MenuFlyoutItem x:Name="UnorderedListButton" Text="Bulleted list"/>
                                            <MenuFlyoutItem x:Name="OrderedListButton" Text="Numbered list"/>
                                            <MenuFlyoutItem x:Name="TaskListButton" Text="Task list"/>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Name="CodeBlockButton" Text="Code block"/>
                                        <MenuFlyoutItem x:Name="BlockMathButton" Text="Math block"/>
                                        <MenuFlyoutSubItem x:Name="CalloutMenuItem" Text="Callout">
                                            <MenuFlyoutItem x:Name="CalloutNoteMenuItem" Text="Note"/>
                                            <MenuFlyoutItem x:Name="CalloutTipMenuItem" Text="Tip"/>
                                            <MenuFlyoutItem x:Name="CalloutWarningMenuItem" Text="Warning"/>
                                        </MenuFlyoutSubItem>
                                    </MenuFlyoutSubItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </SwapChainPanel.ContextFlyout>
                    </SwapChainPanel>
                    <ScrollBar
                        x:Name="EditorScrollBar"
                        Grid.Column="1"
                        Width="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource FoliaShellLayerBrush}"
                        IndicatorMode="MouseIndicator"
                        IsTabStop="False"
                        Minimum="0"
                        Orientation="Vertical"
                        SmallChange="48"
                        UseLayoutRounding="False"/>
                  </Grid>
            <Canvas
                x:Name="EditorOverlay"
                IsHitTestVisible="False"
                Canvas.ZIndex="20">
                <Border
                    x:Name="LatexSuggestionPopup"
                    Width="430"
                    MaxHeight="330"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid
                            Padding="12,9"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ColumnDefinitions="Auto,*,Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cambria Math"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="∑"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="LaTeX"/>
                            <TextBlock
                                x:Name="LatexSuggestionPrefix"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource FoliaMonoFontFamily}"
                                Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                                Text="\"/>
                        </Grid>
                        <ListView
                            x:Name="LatexSuggestionList"
                            Grid.Row="1"
                            MaxHeight="250"
                            HorizontalContentAlignment="Stretch"
                            SelectionMode="Single"
                            SingleSelectionFollowsFocus="False"/>
                        <Border
                            Grid.Row="2"
                            Padding="12,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="LatexSuggestionHint"
                                FontSize="11"
                                Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                                Text="↑↓  Navigate     Tab / Enter  Insert     Esc  Close"/>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
                  <Border x:Name="DocumentLoadingOverlay" Canvas.ZIndex="30" Visibility="Collapsed" Background="{ThemeResource FoliaShellBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <ProgressRing IsActive="True" Width="24" Height="24"/>
                        <TextBlock x:Name="DocumentLoadingText" Text="Preparing document…"/>
                    </StackPanel>
                  </Border>
                </Grid>

                   </SplitView.Content>
                  </SplitView>
                </SplitView.Content>
            </SplitView>
            <Grid x:Name="SettingsViewHost" Visibility="Collapsed"/>
        </Grid>

        <Grid
            x:Name="StatusBar"
            Grid.Row="5"
            MinHeight="32"
            Padding="10,3,8,3"
            Background="{ThemeResource FoliaShellLayerBrush}"
            BorderBrush="{ThemeResource FoliaShellBorderBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                Text="Ready"
                TextTrimming="CharacterEllipsis"/>
            <ProgressBar
                x:Name="OperationProgressBar"
                Grid.Column="1"
                Width="160"
                Margin="12,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource FoliaShellAccentBrush}"
                IsIndeterminate="True"
                IsTabStop="False"
                Maximum="100"
                Minimum="0"
                Visibility="Collapsed"/>
            <Button
                x:Name="CancelOperationButton"
                Grid.Column="2"
                Width="16"
                Height="16"
                MinWidth="16"
                MinHeight="16"
                Margin="0,0,8,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Black"
                BorderThickness="0"
                CornerRadius="8"
                HorizontalContentAlignment="Center"
                IsTabStop="False"
                ToolTipService.ToolTip="Cancel operation"
                VerticalContentAlignment="Center"
                Visibility="Collapsed">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="8"
                    Foreground="White"
                    Glyph="&#xE711;"/>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14">
                <TextBlock
                    x:Name="DocumentNameText"
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    Text="Untitled.md"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    x:Name="CharacterCountText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                    Text="0 characters"/>
                <TextBlock
                    x:Name="RevisionText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                    Text="Revision 0"/>
                <Button
                    x:Name="EncodingButton"
                    MinHeight="24"
                    Padding="6,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="UTF-8"
                    Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                    ToolTipService.ToolTip="Select file encoding"/>
                <ToggleButton
                    x:Name="SourceModeButton"
                    MinWidth="36"
                    Padding="8,2"
                    FontFamily="{ThemeResource FoliaMonoFontFamily}"
                    Content="&lt;/&gt;"
                    ToolTipService.ToolTip="Source mode"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
