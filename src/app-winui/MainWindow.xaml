<Window
    x:Class="Folia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Folia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Folia">
    <Grid
        x:Name="Root"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
          <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="workspace/WorkspaceChrome.xaml"/><ResourceDictionary Source="workspace/FolderExplorer.xaml"/></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="FoliaShellBackgroundBrush" Color="#121419"/>
            <SolidColorBrush x:Key="FoliaShellLayerBrush" Color="#191C23"/>
            <SolidColorBrush x:Key="FoliaShellBorderBrush" Color="#343A46"/>
            <SolidColorBrush x:Key="FoliaShellForegroundBrush" Color="#E4E8F0"/>
            <SolidColorBrush x:Key="FoliaShellMutedForegroundBrush" Color="#8B95AA"/>
            <SolidColorBrush x:Key="FoliaShellAccentBrush" Color="#7AA2F7"/>
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="FoliaShellLayerBrush"/>
            <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="FoliaShellLayerBrush"/>
            <Style x:Key="FoliaMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="Background" Value="{StaticResource FoliaShellLayerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FoliaShellBorderBrush}"/>
                <Setter Property="SystemBackdrop" Value="{x:Null}"/>
            </Style>
            <x:Double x:Key="FoliaReadingMaterialOpacity">0.40</x:Double>
            <x:Double x:Key="FoliaSharedReadingMaterialOpacity">0.58</x:Double>
            <x:Double x:Key="FoliaAcrylicReadingOpacity">0.64</x:Double>
            <x:Double x:Key="FoliaSolidBaseTintBlend">0.12</x:Double>
            <SolidColorBrush x:Key="FoliaWorkspaceBaseBrush"/>
            <SolidColorBrush x:Key="FoliaReadingSurfaceBrush"/>
            <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="FoliaReadingSurfaceBrush"/>
            <x:Double x:Key="WorkspaceTabHeight">36</x:Double>
            <FontFamily x:Key="FoliaUiFontFamily">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="FoliaMonoFontFamily">Cascadia Mono</FontFamily>
            <x:Double x:Key="FoliaUiFontSize">14</x:Double>
            <Style x:Key="CodeLanguagePickerPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Padding" Value="8"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>
            <DataTemplate x:Key="CodeLanguagePickerTemplate">
                <Grid Width="248" RowDefinitions="Auto,Auto">
                    <TextBox x:Name="Search" MinHeight="32" FontSize="14" FontFamily="{ThemeResource FoliaUiFontFamily}"
                             BorderThickness="0" Padding="8,4" CornerRadius="4"/>
                    <ListView x:Name="Languages" Grid.Row="1" Margin="0,6,0,0" MaxHeight="224"
                              FontSize="14" FontFamily="{ThemeResource FoliaUiFontFamily}" SelectionMode="Single" IsItemClickEnabled="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </DataTemplate>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
                <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
                <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
            </Style>
          </ResourceDictionary>
        </Grid.Resources>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="WorkspaceRail" Padding="5,0,5,8" RowDefinitions="Auto,Auto,*,Auto" Canvas.ZIndex="2">
                <Border Height="{StaticResource WorkspaceTabHeight}"/>
                <StackPanel Grid.Row="1" Spacing="5">
                    <ToggleButton x:Name="FilesTab" Style="{StaticResource WorkspaceRailButtonStyle}"/>
                    <ToggleButton x:Name="OutlineTab" Style="{StaticResource WorkspaceRailButtonStyle}"/>
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Row="3" Style="{StaticResource WorkspaceRailActionStyle}"/>
            </Grid>
            <ScrollViewer x:Name="SidebarSlot" Grid.Column="1" Width="0" Padding="0"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                          IsTabStop="False" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch">
            <Grid x:Name="WorkspaceSidebar" Padding="4,0,6,7" Visibility="Collapsed">
            <Grid x:Name="ExplorerPane" RowDefinitions="Auto,Auto,*">
                <Grid x:Name="FolderHeader" Height="{StaticResource WorkspaceTabHeight}" Padding="8,0,0,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      Visibility="Collapsed">
                    <TextBlock Text="{Binding Name}" ToolTipService.ToolTip="{Binding FullPath}"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button x:Name="FolderNewFileButton" Grid.Column="1" Command="{Binding NewFile}" Style="{StaticResource ExplorerHeaderButtonStyle}"/>
                    <Button x:Name="FolderNewFolderButton" Grid.Column="2" Command="{Binding NewFolder}" Style="{StaticResource ExplorerHeaderButtonStyle}"/>
                    <Button x:Name="FolderRefreshButton" Grid.Column="3" Command="{Binding Refresh}" Style="{StaticResource ExplorerHeaderButtonStyle}"/>
                    <Button x:Name="FolderCollapseButton" Grid.Column="4" Command="{Binding Collapse}" Style="{StaticResource ExplorerHeaderButtonStyle}"/>
                </Grid>
                <StackPanel x:Name="FileOperationPanel" Grid.Row="1" Margin="16,8,12,8" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="FileOperationText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
                    <ProgressBar x:Name="FileOperationProgress" Height="2" MinHeight="2" IsIndeterminate="True"/>
                </StackPanel>
                <StackPanel x:Name="ExplorerEmptyState" Grid.Row="2" Margin="12,45,12,12" Spacing="8" VerticalAlignment="Top">
                    <TextBlock x:Name="NoFolderHeading" FontSize="13" FontWeight="SemiBold" Text="No folder open"/>
                    <TextBlock x:Name="NoFolderHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}" Text="Open a folder to browse Markdown files."/>
                    <HyperlinkButton x:Name="OpenFolderPaneButton" Content="Open folder…" HorizontalAlignment="Left" Padding="0" FontSize="13"/>
                </StackPanel>
                <TreeView x:Name="FileTree" Grid.Row="2" Margin="1,3,2,8" Style="{StaticResource ExplorerTreeStyle}" Visibility="Collapsed"/>
            </Grid>
            <Grid x:Name="OutlinePaneContent" Padding="4,36,4,4" Visibility="Collapsed">
                <ListView x:Name="OutlineList" Background="Transparent" SelectionMode="Single"
                          ItemContainerStyle="{StaticResource WorkspaceNavigationItemStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled"/>
                <TextBlock x:Name="OutlineEmptyText" Margin="12,12" FontSize="13"
                           Foreground="{ThemeResource FoliaShellMutedForegroundBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>
            </Grid>
            </ScrollViewer>
        <Grid x:Name="DocumentColumn" Grid.Column="2" RowDefinitions="Auto,*" MinWidth="0">
        <SystemBackdropElement x:Name="ReadingBackdrop" Grid.RowSpan="2"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
        <Grid x:Name="TopChrome" ColumnDefinitions="Auto,*,Auto" Height="{StaticResource WorkspaceTabHeight}" Canvas.ZIndex="2">
        <ToggleButton x:Name="SidebarButton" Margin="4,0" Style="{StaticResource WorkspacePaneToggleStyle}"/>
        <Grid x:Name="TabViewport" Grid.Column="1" MinWidth="0">
        <Grid.Clip><RectangleGeometry x:Name="TabViewportClip"/></Grid.Clip>
        <TabView x:Name="DocumentTabs"
                 MinWidth="0"
                 IsAddTabButtonVisible="True" CloseButtonOverlayMode="OnPointerOver" TabWidthMode="Equal" CanDragTabs="True" CanReorderTabs="True" AllowDrop="True"
                 Padding="0" BorderThickness="0" Background="Transparent">
            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem Tag="{Binding}" Height="{StaticResource WorkspaceTabHeight}" Margin="0"
                                 HorizontalContentAlignment="Stretch" DoubleTapped="DocumentTabDoubleTapped"
                                 DataContextChanged="DocumentTabPrepared" Loaded="DocumentTabLoaded">
                        <TabViewItem.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center" UseLayoutRounding="True">
                                <ContentControl Width="16" VerticalAlignment="Center" IsTabStop="False"/>
                                <TextBlock Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="&#x25CF;" FontSize="8" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </TabViewItem.Header>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
            <TabView.Resources>
                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent"/>
                <Thickness x:Key="TabViewSelectedItemBorderThickness">0</Thickness>
                <Style x:Key="TabViewButtonStyle" TargetType="Button" BasedOn="{StaticResource WorkspaceToolActionStyle}"/>
                <Thickness x:Key="TabViewItemAddButtonContainerPadding">4,5,4,5</Thickness>
            </TabView.Resources>
            <TabView.TabStripFooter>
                <Border x:Name="TitleDragArea" Height="{StaticResource WorkspaceTabHeight}" Width="36"
                        HorizontalAlignment="Left" Background="Transparent"/>
            </TabView.TabStripFooter>
        </TabView>
        </Grid>
        <Border x:Name="CaptionInset" Grid.Column="2" Width="138"/>
        </Grid>
        <Grid x:Name="ReadingCard" Grid.Row="1" Margin="4,0,6,6" CornerRadius="9">
        <Border x:Name="ReadingTint" CornerRadius="9" IsHitTestVisible="False"/>
        <Grid x:Name="ReadingLayout" RowDefinitions="Auto,*">
        <Grid x:Name="DocumentToolbar" MinHeight="30" VerticalAlignment="Top" Canvas.ZIndex="2"
              Background="Transparent" Padding="5,0,6,0" ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="DocumentActionsButton" Style="{StaticResource WorkspaceToolActionStyle}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" MenuFlyoutPresenterStyle="{StaticResource FoliaMenuPresenterStyle}">
                        <MenuFlyoutItem x:Name="OpenButton" Text="Open file" KeyboardAcceleratorTextOverride="Ctrl+O"/>
                        <MenuFlyoutItem x:Name="OpenFolderButton" Text="Open folder" KeyboardAcceleratorTextOverride="Ctrl+Shift+O"/>
                        <MenuFlyoutSubItem x:Name="RecentFilesMenu" Text="Open Recent File"/>
                        <MenuFlyoutSubItem x:Name="RecentFoldersMenu" Text="Open Recent Folder"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="SaveButton" Text="Save" KeyboardAcceleratorTextOverride="Ctrl+S"/>
                        <MenuFlyoutItem x:Name="SaveAsButton" Text="Save as"/>
                        <MenuFlyoutItem x:Name="ReloadButton" Text="Reload"/>
                        <MenuFlyoutItem x:Name="ExportPdfButton" Text="PDF"/>
                        <MenuFlyoutItem x:Name="CloseTabButton" Text="Close tab" KeyboardAcceleratorTextOverride="Ctrl+W"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="ToolbarFilename" Grid.Column="1" Margin="6,0" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel x:Name="CompletionStatusPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressRing x:Name="CompletionProgressRing" Style="{StaticResource FoliaCompletionProgressStyle}" IsActive="False" Visibility="Collapsed"/>
                    <TextBlock x:Name="CompletionStatusText" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CharacterCountText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
                <TextBlock x:Name="ImageSizeText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}" Visibility="Collapsed"/>
                <Button x:Name="EncodingButton" FontSize="12" MinHeight="22" Height="22" Padding="5,0" Style="{StaticResource SubtleButtonStyle}"
                        Foreground="{ThemeResource FoliaShellMutedForegroundBrush}">
                    <Button.Flyout>
                        <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource FoliaMenuPresenterStyle}">
                            <MenuFlyoutItem x:Name="ReopenEncodingItem"/>
                            <MenuFlyoutItem x:Name="SaveEncodingItem"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="SourceModeButton" Style="{StaticResource WorkspacePaneToggleStyle}"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="DocumentViewport" Grid.Row="1" RowDefinitions="Auto,*">

        <Border
            x:Name="FindReplaceBar"
            Padding="10,8"
            Background="{ThemeResource FoliaShellLayerBrush}"
            BorderBrush="{ThemeResource FoliaShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox
                        x:Name="FindQueryBox"
                        Width="320"
                        MinWidth="180"
                        PlaceholderText="Find"/>
                    <ToggleButton
                        x:Name="FindRegexButton"
                        MinWidth="36"
                        Content=".*"
                        FontFamily="{ThemeResource FoliaMonoFontFamily}"
                        ToolTipService.ToolTip="Regular expression"/>
                    <ToggleButton
                        x:Name="FindCaseButton"
                        MinWidth="36"
                        Content="Aa"
                        ToolTipService.ToolTip="Match case"/>
                    <TextBlock
                        x:Name="FindMatchCountText"
                        MinWidth="72"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                        Text="0 results"/>
                    <Button x:Name="FindPreviousButton" MinWidth="36" Content="↑" ToolTipService.ToolTip="Previous match"/>
                    <Button x:Name="FindNextButton" MinWidth="36" Content="↓" ToolTipService.ToolTip="Next match"/>
                </StackPanel>
                <Button
                    x:Name="CloseFindButton"
                    Grid.Column="1"
                    MinWidth="36"
                    Content="&#xE711;"
                    FontFamily="Segoe Fluent Icons"
                    ToolTipService.ToolTip="Close"/>
                <StackPanel
                    x:Name="ReplaceControls"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="ReplaceTextBox"
                        Width="320"
                        MinWidth="180"
                        PlaceholderText="Replace"/>
                    <Button x:Name="ReplaceCurrentButton" Content="Replace"/>
                    <Button x:Name="ReplaceAllButton" Content="Replace all"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceHost" Grid.Row="1">
                <Grid x:Name="DocumentPages">
                <Grid x:Name="EditorPane">

                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="EditorScrollBarColumn" Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="EditorSurface" Grid.Column="0" Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="CodeLanguageFlyout" Placement="BottomEdgeAlignedLeft"
                                    FlyoutPresenterStyle="{StaticResource CodeLanguagePickerPresenterStyle}"/>
                        </FlyoutBase.AttachedFlyout>
                        <Grid.ContextFlyout>
                            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource FoliaMenuPresenterStyle}">
                                <MenuFlyoutItem x:Name="UndoButton" Text="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z"/>
                                <MenuFlyoutItem x:Name="RedoButton" Text="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="CutMenuItem" Text="Cut"/>
                                <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy"/>
                                <MenuFlyoutItem x:Name="PasteMenuItem" Text="Paste"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="SelectAllMenuItem" Text="Select All"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="FindButton" Text="Find" KeyboardAcceleratorTextOverride="Ctrl+F"/>
                                <MenuFlyoutItem x:Name="ReplaceButton" Text="Replace" KeyboardAcceleratorTextOverride="Ctrl+H"/>
                                <MenuFlyoutSubItem x:Name="FormatMenu" Text="Format">
                                    <ToggleMenuFlyoutItem x:Name="BoldButton" Text="Bold"/>
                                    <ToggleMenuFlyoutItem x:Name="ItalicButton" Text="Italic"/>
                                    <ToggleMenuFlyoutItem x:Name="StrikeButton" Text="Strikethrough"/>
                                    <ToggleMenuFlyoutItem x:Name="InlineCodeButton" Text="Inline code"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="FormatDocumentButton" Text="Format document"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="InsertButton" Text="Insert">
                                    <MenuFlyoutItem x:Name="TableButton" Text="Table"/>
                                    <MenuFlyoutItem x:Name="InlineMathButton" Text="Inline math"/>
                                    <MenuFlyoutItem x:Name="LinkButton" Text="Link"/>
                                    <MenuFlyoutItem x:Name="ImageButton" Text="Image"/>
                                    <MenuFlyoutItem x:Name="FootnoteButton" Text="Footnote"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="TocButton" Text="Table of contents"/>
                                    <MenuFlyoutSubItem x:Name="BlocksButton" Text="Blocks">
                                        <MenuFlyoutSubItem x:Name="HeadingMenuItem" Text="Heading">
                                            <MenuFlyoutItem x:Name="Heading1Button" Text="Heading 1"/>
                                            <MenuFlyoutItem x:Name="Heading2Button" Text="Heading 2"/>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem x:Name="QuoteButton" Text="Quote"/>
                                        <MenuFlyoutSubItem x:Name="ListMenuItem" Text="List">
                                            <MenuFlyoutItem x:Name="UnorderedListButton" Text="Bulleted list"/>
                                            <MenuFlyoutItem x:Name="OrderedListButton" Text="Numbered list"/>
                                            <MenuFlyoutItem x:Name="TaskListButton" Text="Task list"/>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Name="CodeBlockButton" Text="Code block"/>
                                        <MenuFlyoutItem x:Name="BlockMathButton" Text="Math block"/>
                                        <MenuFlyoutSubItem x:Name="CalloutMenuItem" Text="Callout">
                                            <MenuFlyoutItem x:Name="CalloutNoteMenuItem" Text="Note"/>
                                            <MenuFlyoutItem x:Name="CalloutTipMenuItem" Text="Tip"/>
                                            <MenuFlyoutItem x:Name="CalloutWarningMenuItem" Text="Warning"/>
                                        </MenuFlyoutSubItem>
                                    </MenuFlyoutSubItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                    <ScrollBar
                        x:Name="EditorScrollBar"
                        Grid.Column="1"
                        Width="16"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        IndicatorMode="MouseIndicator"
                        IsTabStop="False"
                        Minimum="0"
                        Orientation="Vertical"
                        SmallChange="48"
                        UseLayoutRounding="False"/>
                  </Grid>
            <Canvas
                x:Name="EditorOverlay"
                IsHitTestVisible="False"
                Canvas.ZIndex="20">
                <Border
                    x:Name="LatexSuggestionPopup"
                    Width="430"
                    MaxHeight="330"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid
                            Padding="12,9"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ColumnDefinitions="Auto,*,Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cambria Math"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="∑"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="LaTeX"/>
                            <TextBlock
                                x:Name="LatexSuggestionPrefix"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource FoliaMonoFontFamily}"
                                Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                                Text="\"/>
                        </Grid>
                        <ListView
                            x:Name="LatexSuggestionList"
                            Grid.Row="1"
                            MaxHeight="250"
                            HorizontalContentAlignment="Stretch"
                            SelectionMode="Single"
                            SingleSelectionFollowsFocus="False"/>
                        <Border
                            Grid.Row="2"
                            Padding="12,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock
                                x:Name="LatexSuggestionHint"
                                FontSize="11"
                                Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"
                                Text="↑↓  Navigate     Tab / Enter  Insert     Esc  Close"/>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
                  <Grid x:Name="DocumentLoadingOverlay" Canvas.ZIndex="30" Visibility="Collapsed"
                        Background="{ThemeResource FoliaShellBackgroundBrush}"/>
                  <Border x:Name="OperationPanel" Canvas.ZIndex="31" Visibility="Collapsed" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Padding="18,12" CornerRadius="8" Background="{ThemeResource FoliaShellBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                            <ProgressRing x:Name="OperationRing" Width="52" Height="52" IsIndeterminate="False" IsActive="False"
                                          Minimum="0" Maximum="100" Foreground="{ThemeResource FoliaShellAccentBrush}"
                                          Background="{ThemeResource FoliaShellBorderBrush}"/>
                            <TextBlock x:Name="OperationPercent" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="DocumentLoadingText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="CancelOperationButton" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center"
                                FontSize="12" MinHeight="24" Padding="8,2" Visibility="Collapsed"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid x:Name="ImagePreviewPane" Visibility="Collapsed">
                    <ScrollViewer x:Name="ImagePreviewViewer" Margin="24" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                 MaxWidth="{x:Bind ImagePreviewViewer.ViewportWidth, Mode=OneWay}"
                                 MaxHeight="{x:Bind ImagePreviewViewer.ViewportHeight, Mode=OneWay}">
                            <Image x:Name="WorkspaceImage" Stretch="Uniform"/>
                        </Viewbox>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
                        <ProgressRing x:Name="ImagePreviewProgress" Width="24" Height="24" Visibility="Collapsed"/>
                        <TextBlock x:Name="ImagePreviewMessage" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
                </Grid>
            <ContentControl x:Name="SettingsViewHost" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
        </Grid>
        </Grid>
        <ScrollViewer x:Name="WorkspaceNotifications" Canvas.ZIndex="3"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="420"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <StackPanel Spacing="6">
                <InfoBar x:Name="ExternalChangeInfoBar" Severity="Warning" IsClosable="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReloadExternalButton" Content="Reload"/>
                        <Button x:Name="KeepLocalButton" Content="Keep local changes"/>
                    </StackPanel>
                </InfoBar>
                <InfoBar x:Name="ErrorInfoBar" Severity="Error" IsClosable="True"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
