<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native defaults also allow settings controls to be constructed before
         they are attached to a window with a selected Folia theme profile. -->
    <StaticResource x:Key="FoliaUiFontFamily" ResourceKey="ContentControlThemeFontFamily"/>
    <StaticResource x:Key="FoliaUiFontSize" ResourceKey="ControlContentThemeFontSize"/>
    <FontFamily x:Key="FoliaMonoFontFamily">Cascadia Mono</FontFamily>
    <StaticResource x:Key="FoliaShellForegroundBrush" ResourceKey="TextFillColorPrimaryBrush"/>
    <StaticResource x:Key="FoliaShellMutedForegroundBrush" ResourceKey="TextFillColorSecondaryBrush"/>
    <StaticResource x:Key="FoliaShellAccentBrush" ResourceKey="AccentTextFillColorPrimaryBrush"/>
    <StaticResource x:Key="FoliaShellLayerBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
    <StaticResource x:Key="FoliaShellBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush"/>
    <x:Double x:Key="SettingsSectionGap">24</x:Double>
    <x:Double x:Key="SettingsWidePageWidth">720</x:Double>
    <x:Double x:Key="SettingsThemeListWidth">260</x:Double>
    <x:Double x:Key="SettingsModelPickerWidth">320</x:Double>
    <x:Double x:Key="SettingsModelPickerMaxHeight">320</x:Double>
    <!-- Cap the content column, not the stretched page itself: a stretched
         element with MaxWidth is centered inside a wider layout slot. -->
    <DataTemplate x:Key="SettingsPageViewportTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1008"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="PageContent"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
        </Grid>
    </DataTemplate>
    <!-- Shared native settings presentation. Theme profile brushes/fonts are
         supplied by the window; control states remain WinUI's responsibility. -->
    <Style x:Key="SettingsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingsHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellMutedForegroundBrush}"/>
    </Style>
    <Style x:Key="SettingsPageHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsAppNameStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsPageHeadingStyle}">
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="SettingsPageStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24"/><Setter Property="Spacing" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsGridPageStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24"/><Setter Property="RowSpacing" Value="24"/>
    </Style>
    <Style x:Key="SettingsSectionPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style x:Key="SettingsPageHeaderStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style x:Key="SettingsSectionGridStyle" TargetType="Grid">
        <Setter Property="RowSpacing" Value="24"/>
    </Style>
    <DataTemplate x:Key="SettingsLicenseLineTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource SettingsBodyTextStyle}"
                   FontFamily="{ThemeResource FoliaMonoFontFamily}" MinHeight="20"/>
    </DataTemplate>
    <Style x:Key="SettingsLicenseLineStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="20"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SettingsPageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollMode" Value="Enabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsListSeparatorStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FoliaShellBorderBrush}"/>
    </Style>
    <Style x:Key="SettingsListRowStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>
    <ItemsPanelTemplate x:Key="SettingsListItemsPanel">
        <ItemsStackPanel CacheLength="0.5"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="SettingsListRowTemplate">
        <ContentPresenter HorizontalContentAlignment="Stretch"/>
    </DataTemplate>
    <Style x:Key="SettingsListHeaderStyle" TargetType="StackPanel" BasedOn="{StaticResource SettingsSectionPanelStyle}">
        <Setter Property="Spacing" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>
    <Style x:Key="SettingsCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHintTextStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaMonoFontFamily}"/>
    </Style>
    <Style x:Key="SettingsCodeLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsCodeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{ThemeResource FoliaShellLayerBrush}"/>
    </Style>
    <Style x:Key="SettingsThemeListStyle" TargetType="ListView">
        <Setter Property="MinHeight" Value="220"/><Setter Property="MaxHeight" Value="280"/>
    </Style>
</ResourceDictionary>
