<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native defaults also allow settings controls to be constructed before
         they are attached to a window with a selected Folia theme profile. -->
    <StaticResource x:Key="FoliaUiFontFamily" ResourceKey="ContentControlThemeFontFamily"/>
    <StaticResource x:Key="FoliaUiFontSize" ResourceKey="ControlContentThemeFontSize"/>
    <FontFamily x:Key="FoliaMonoFontFamily">Cascadia Mono</FontFamily>
    <StaticResource x:Key="FoliaShellForegroundBrush" ResourceKey="TextFillColorPrimaryBrush"/>
    <StaticResource x:Key="FoliaShellMutedForegroundBrush" ResourceKey="TextFillColorSecondaryBrush"/>
    <StaticResource x:Key="FoliaShellAccentBrush" ResourceKey="AccentTextFillColorPrimaryBrush"/>
    <StaticResource x:Key="FoliaShellLayerBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
    <StaticResource x:Key="FoliaShellBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource SolidBackgroundFillColorSecondary}"/>
    <x:Double x:Key="SettingsSectionGap">24</x:Double>
    <x:Double x:Key="SettingsPageWidth">1008</x:Double>
    <x:Double x:Key="SettingsContentWidth">960</x:Double>
    <DataTemplate x:Key="SettingsRootTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl x:Name="SettingsPageContent" Grid.Row="1"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTransitions>
                    <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False"/>
                </ContentControl.ContentTransitions>
            </ContentControl>
        </Grid>
    </DataTemplate>
    <!-- Scrollers occupy the page. Their content shares a centered column. -->
    <DataTemplate x:Key="SettingsPageViewportTemplate">
        <Grid>
            <ContentPresenter x:Name="PageContent"
                              MaxWidth="{StaticResource SettingsPageWidth}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
        </Grid>
    </DataTemplate>
    <!-- Shared native settings presentation. Theme profile brushes/fonts are
         supplied by the window; control states remain WinUI's responsibility. -->
    <Style x:Key="SettingsBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingsHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellMutedForegroundBrush}"/>
    </Style>
    <Style x:Key="SettingsPageHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsAppNameStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsPageHeadingStyle}">
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="SettingsPageStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24"/><Setter Property="Spacing" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsOptionPageStyle" TargetType="StackPanel" BasedOn="{StaticResource SettingsPageStyle}">
        <Setter Property="ChildrenTransitions">
            <Setter.Value>
                <TransitionCollection>
                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsGridPageStyle" TargetType="Grid">
        <Setter Property="Margin" Value="24"/><Setter Property="RowSpacing" Value="24"/>
    </Style>
    <Style x:Key="SettingsSectionPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style x:Key="SettingsButtonRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style x:Key="SettingsPageHeaderStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <x:Double x:Key="SettingsCardIconColumn">42</x:Double>
    <x:Double x:Key="SettingsCardColumnGap">12</x:Double>
    <x:Double x:Key="SettingsCardFieldGap">10</x:Double>
    <x:Double x:Key="SettingsCardInlineWidth">456</x:Double>
    <Style x:Key="SettingsCardSectionStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="10"/>
    </Style>
    <Style x:Key="SettingsCardListStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="5"/>
    </Style>
    <Style x:Key="SettingsCardLayoutStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SettingsCardColumnGap}"/>
    </Style>
    <Style x:Key="SettingsCardRowStyle" TargetType="Grid" BasedOn="{StaticResource SettingsCardLayoutStyle}">
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="MinHeight" Value="58"/>
    </Style>
    <Style x:Key="SettingsCardCompoundStyle" TargetType="Grid" BasedOn="{StaticResource SettingsCardLayoutStyle}">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="62"/>
    </Style>
    <Style x:Key="SettingsCardSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    <Style x:Key="SettingsCardHoverStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardSurfaceStyle}">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsCardCopyStyle" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Spacing" Value="2"/>
    </Style>
    <Style x:Key="SettingsCardIconStyle" TargetType="Viewbox">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsCardFontIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
    </Style>
    <Style x:Key="SettingsCardLinkStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>
    <Style x:Key="SettingsCardNavigationTargetStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsCardSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsCardInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style x:Key="SettingsProviderMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FoliaShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SettingsProviderInitialsStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellMutedForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsProviderActionIconStyle" TargetType="Viewbox">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsProviderImageStyle" TargetType="Image">
        <Setter Property="Margin" Value="5"/>
    </Style>
    <Style x:Key="SettingsNavigationArrowStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellMutedForegroundBrush}"/>
    </Style>
    <Style x:Key="SettingsHomeButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style x:Key="SettingsBreadcrumbStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="14,12,24,0"/>
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style x:Key="SettingsSubpageBreadcrumbStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style x:Key="SettingsSubpageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsCardTitleStyle}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="MaxWidth" Value="240"/>
    </Style>
    <Style x:Key="SettingsProviderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="SettingsModelEffortsStyle" TargetType="VariableSizedWrapGrid">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="ItemWidth" Value="112"/>
        <Setter Property="ItemHeight" Value="32"/>
    </Style>
    <Style x:Key="SettingsModelEffortToggleStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style x:Key="SettingsThemePreviewStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource FoliaShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style x:Key="SettingsSectionGridStyle" TargetType="Grid">
        <Setter Property="RowSpacing" Value="24"/>
    </Style>
    <Style x:Key="SettingsLicenseDocumentStyle" TargetType="RichEditBox" BasedOn="{StaticResource DefaultRichEditBoxStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaMonoFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsSpellCheckEnabled" Value="False"/>
        <Setter Property="IsTextPredictionEnabled" Value="False"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsCardChoiceStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}">
        <Setter Property="MinWidth" Value="152"/>
        <Setter Property="MaxWidth" Value="268"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="SettingsAccentActionLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="FontSize" Value="{ThemeResource FoliaUiFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SettingsPageScrollStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollMode" Value="Enabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="SettingsListSeparatorStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource FoliaShellBorderBrush}"/>
    </Style>
    <Style x:Key="SettingsListRowStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>
    <ItemsPanelTemplate x:Key="SettingsListItemsPanel">
        <ItemsStackPanel CacheLength="0.5"/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="SettingsListRowTemplate">
        <ContentPresenter MaxWidth="{StaticResource SettingsContentWidth}" Margin="24,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
    </DataTemplate>
    <Style x:Key="SettingsListHeaderStyle" TargetType="StackPanel" BasedOn="{StaticResource SettingsSectionPanelStyle}">
        <Setter Property="Spacing" Value="24"/>
        <Setter Property="Margin" Value="24"/>
    </Style>
    <Style x:Key="SettingsCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHintTextStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaMonoFontFamily}"/>
    </Style>
    <Style x:Key="SettingsCodeLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsCodeTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SettingsBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{ThemeResource FoliaShellLayerBrush}"/>
    </Style>
</ResourceDictionary>
