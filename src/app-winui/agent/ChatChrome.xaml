<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChatFloatingSurfaceBrush" Color="#FFFDFDFE"/>
            <SolidColorBrush x:Key="ChatBubbleBrush" Color="#FFDCE6F1"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ChatFloatingSurfaceBrush" Color="#FF27282C"/>
            <SolidColorBrush x:Key="ChatBubbleBrush" Color="#FF353E4B"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ChatFloatingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ChatBubbleBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="ChatContextTrackStyle" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.40"/>
    </Style>
    <Style x:Key="ChatComposerCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ChatFloatingSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="ChatComposerInputStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="9,5,9,8"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="ChatActionStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Body.Opacity" Value="0.40"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Body" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChatSendStyle" TargetType="Button" BasedOn="{StaticResource ChatActionStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style x:Key="ChatModelPickerPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource ChatFloatingSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ChatModelPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource ChatActionStyle}">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style x:Key="ChatModelPickerLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FoliaUiFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ChatModelPickerSecondaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ChatModelPickerLabelStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FoliaShellMutedForegroundBrush}"/>
    </Style>
    <Style x:Key="ChatModelPickerItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="ChatUserBubbleStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="14,14,4,14"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Background" Value="{ThemeResource ChatBubbleBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <DataTemplate x:Key="ChatModelChipTemplate">
        <Button HorizontalAlignment="Right" CornerRadius="8"
                Style="{StaticResource ChatModelPickerButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="ModelName" MaxWidth="143" Style="{StaticResource ChatModelPickerLabelStyle}"/>
                <TextBlock x:Name="ModelEffort" Style="{StaticResource ChatModelPickerSecondaryLabelStyle}"/>
                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource FoliaShellMutedForegroundBrush}"/>
            </StackPanel>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="ChatModelPickerTemplate">
        <Grid Width="240">
            <StackPanel x:Name="ReasoningPanel" Spacing="4">
                <Button x:Name="ChooseModel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Style="{StaticResource ChatModelPickerButtonStyle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="CurrentModel" FontWeight="SemiBold" Style="{StaticResource ChatModelPickerLabelStyle}"/>
                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11"/>
                    </Grid>
                </Button>
                <TextBlock x:Name="EffortTitle" Margin="8,7,0,1" FontSize="12" Style="{StaticResource ChatModelPickerSecondaryLabelStyle}"/>
                <ListView x:Name="Efforts" MaxHeight="228" SelectionMode="Single" SingleSelectionFollowsFocus="False"
                          ItemContainerStyle="{StaticResource ChatModelPickerItemStyle}"/>
            </StackPanel>
            <StackPanel x:Name="ModelsPanel" Spacing="6">
                <Grid ColumnDefinitions="Auto,*" MinHeight="32">
                    <Button x:Name="BackToReasoning" Padding="0" Margin="0,0,3,0" Style="{StaticResource ChatModelPickerButtonStyle}">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    </Button>
                    <TextBlock x:Name="ChooseModelTitle" Grid.Column="1" Margin="8,0" FontWeight="SemiBold"
                               Style="{StaticResource ChatModelPickerLabelStyle}"/>
                </Grid>
                <ListView x:Name="ModelList" MaxHeight="312" SelectionMode="Single" SingleSelectionFollowsFocus="False"
                          ItemContainerStyle="{StaticResource ChatModelPickerItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <StackPanel x:Name="MissingModels" Spacing="8" Padding="8,4,8,2" Visibility="Collapsed">
                    <TextBlock x:Name="MissingModelsMessage" TextWrapping="Wrap"
                               Style="{StaticResource ChatModelPickerSecondaryLabelStyle}"/>
                    <Button x:Name="ConfigureModels" Style="{StaticResource ChatModelPickerButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
