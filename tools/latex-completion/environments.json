  "prooftree": {
    "body": "\\AxiomC{${1:A}}\n\\UnaryInfC{${2:B}}"
  },
  "CD": {
    "body": "$1 @>{${2:f}}>> $3 \\\\\n@V{${4:g}}VV @VV{${5:h}}V \\\\\n$6 @>>{${7:k}}> $8"
