diff --git a/src/scantoken.cpp b/src/scantoken.cpp
index b13d211..4e4aea5 100644
--- a/src/scantoken.cpp
+++ b/src/scantoken.cpp
@@ -289,6 +289,17 @@ void Scanner::ScanTag() {
       token.params.push_back(ScanTagSuffix(INPUT));
       token.data = Tag::NAMED_HANDLE;
     }
+
+    // js-yaml reads a non-verbatim tag through whitespace. A flow indicator
+    // immediately after the suffix is therefore an invalid part of the tag,
+    // not the end of an empty tagged node. Whitespace-separated empty nodes
+    // and verbatim tags remain valid.
+    if (INPUT && (INPUT.peek() == Keys::FlowSeqStart ||
+                  INPUT.peek() == Keys::FlowSeqEnd ||
+                  INPUT.peek() == Keys::FlowMapStart ||
+                  INPUT.peek() == Keys::FlowMapEnd ||
+                  INPUT.peek() == Keys::FlowEntry))
+      throw ParserException(INPUT.mark(), ErrorMsg::INVALID_TAG);
   }

   m_tokens.push(token);
diff --git a/src/singledocparser.cpp b/src/singledocparser.cpp
index 04ea4f2..33db068 100644
--- a/src/singledocparser.cpp
+++ b/src/singledocparser.cpp
@@ -141,8 +141,15 @@ void SingleDocParser::HandleNode(EventHandler& eventHandler) {
       break;
   }

-  if (tag == "?")
+  if (tag == "?" || tag == "!")
     eventHandler.OnNull(mark, anchor);
+  else if (tag == "tag:yaml.org,2002:seq") {
+    eventHandler.OnSequenceStart(mark, tag, anchor, EmitterStyle::Default);
+    eventHandler.OnSequenceEnd();
+  } else if (tag == "tag:yaml.org,2002:map") {
+    eventHandler.OnMapStart(mark, tag, anchor, EmitterStyle::Default);
+    eventHandler.OnMapEnd();
+  }
   else
     eventHandler.OnScalar(mark, tag, anchor, "");
 }
