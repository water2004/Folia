diff --git a/src/singledocparser.cpp b/src/singledocparser.cpp
--- a/src/singledocparser.cpp
+++ b/src/singledocparser.cpp
@@ -144,5 +144,15 @@ void SingleDocParser::HandleNode(EventHandler& eventHandler) {
   if (tag == "?")
     eventHandler.OnNull(mark, anchor);
+  else if (m_pCollectionStack->GetCurCollectionType() == CollectionType::FlowMap ||
+           m_pCollectionStack->GetCurCollectionType() == CollectionType::FlowSeq)
+    throw ParserException(mark, ErrorMsg::FLOW_END);
+  else if (tag == "tag:yaml.org,2002:seq") {
+    eventHandler.OnSequenceStart(mark, tag, anchor, EmitterStyle::Default);
+    eventHandler.OnSequenceEnd();
+  } else if (tag == "tag:yaml.org,2002:map") {
+    eventHandler.OnMapStart(mark, tag, anchor, EmitterStyle::Default);
+    eventHandler.OnMapEnd();
+  }
   else
     eventHandler.OnScalar(mark, tag, anchor, "");
 }
